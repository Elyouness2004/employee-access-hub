# Server blocks, rendered by the nginx image's envsubst at start-up.
# Only ${NGINX_*} variables are substituted (NGINX_ENVSUBST_FILTER=^NGINX_);
# nginx runtime variables ($host, $scheme, …) are left untouched.

# --- HTTP: ACME challenge + redirect everything else to HTTPS ---
server {
    listen      80;
    listen      [::]:80;
    server_name ${NGINX_API_HOST} ${NGINX_AUTH_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;              # certbot webroot (Let's Encrypt)
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS: API edge -> gateway ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${NGINX_API_HOST};

    ssl_certificate     /etc/nginx/certs/${NGINX_API_HOST}.crt;
    ssl_certificate_key /etc/nginx/certs/${NGINX_API_HOST}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # transport + content security (HSTS belongs here — TLS terminates at nginx)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "no-referrer" always;
    add_header Content-Security-Policy    "default-src 'none'; frame-ancestors 'none'" always;
    add_header Permissions-Policy         "geolocation=(), camera=(), microphone=()" always;

    limit_conn conns 50;

    location / {
        limit_req zone=api burst=40 nodelay;
        proxy_pass http://gateway:8080;
    }

    # brief caching for the read-only OpenAPI docs (example caching header)
    location /v3/api-docs {
        proxy_pass http://gateway:8080;
        add_header Cache-Control "public, max-age=300";
    }
}

# --- HTTPS: Auth edge -> Keycloak (issuer host) ---
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${NGINX_AUTH_HOST};

    ssl_certificate     /etc/nginx/certs/${NGINX_AUTH_HOST}.crt;
    ssl_certificate_key /etc/nginx/certs/${NGINX_AUTH_HOST}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://keycloak:8080;
        proxy_set_header X-Forwarded-Proto https;   # Keycloak builds issuer URLs from this
    }
}
